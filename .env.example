# Anthropic API Key (Claude queries in the audit, plus /create)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API Key (ChatGPT queries in the audit)
OPENAI_API_KEY=sk-your-openai-key-here

# Set to 'true' to use mock responses instead of real API calls
MOCK_MODE=true

# Database (libsql / Turso). Backs auth, snapshots, and the rate limiter
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Email gate (required for email verification)
HMAC_SECRET=generate-with-openssl-rand-hex-32
RESEND_API_KEY=re_your-resend-key-here
RESEND_FROM_EMAIL=noreply@llmsgist.org

# Where inbound notifications land
GALLERY_SUBMIT_TO_EMAIL=you@example.com
REQUEST_PRIVATE_TO_EMAIL=you@example.com

# Guards /api/cron/weekly-audit
CRON_SECRET=generate-with-openssl-rand-hex-32

# Local development only. Bypasses the rate limiter
DISABLE_RATE_LIMIT=true
